# ===========================================================================
# WebSR 环境变量 · 示例（可入库，不含任何真实凭证）
#
# 用法：复制为 .env.dev 用于开发；生产覆盖值写入 .env.prd（不跟踪）
# 键名以 APP_ 前缀统一，避免与系统环境变量冲突
# 完整说明见 docs/tech/dev-info.md §6
# ===========================================================================

# 数据根目录（应用数据统一在此：models / uploads / outputs / thumbs / calibration）
APP_DATA_DIR=./data

# SQLite 元信息库连接串（只存元信息与索引，图片本体走文件系统）
APP_DB_URL=sqlite:///./data/app.db

# 后端绑定地址与端口
#   本地单机形态必须绑 127.0.0.1；无反向代理的部署形态才绑 0.0.0.0
APP_HOST=127.0.0.1
APP_PORT=8000

# 日志级别：debug | info | warning | error
APP_LOG_LEVEL=info

# 上传单文件大小上限（MB）
APP_MAX_UPLOAD_MB=50

# 允许的前端来源（开发期由 Vite proxy 规避；此处置白名单，禁止使用 *）
APP_CORS_ORIGINS=http://127.0.0.1:5173

# 模型下载镜像源（可选，留空表示使用默认）
HF_ENDPOINT=
