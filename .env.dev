# ===========================================================================
# WebSR 环境变量 · 开发环境（可入库，不含真实凭证）
#
# 与 .env.example 的键名保持完全一致；差异只在取值
# 生产覆盖值写入 .env.prd（不在版本库中）
# ===========================================================================

APP_DATA_DIR=./data
APP_DB_URL=sqlite:///./data/app.db
APP_HOST=127.0.0.1
APP_PORT=8000
APP_LOG_LEVEL=debug
APP_MAX_UPLOAD_MB=50
APP_CORS_ORIGINS=http://127.0.0.1:5173
HF_ENDPOINT=
