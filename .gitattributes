# 仓库内统一以 LF 存储，避免 Windows / Linux 之间来回改写行尾
* text=auto eol=lf

# Windows 专属脚本保留 CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制资产：不做行尾转换，不尝试 diff
*.onnx        binary
*.bin         binary
*.pth         binary
*.safetensors binary
*.db          binary
*.png         binary
*.jpg         binary
*.jpeg        binary
*.webp        binary
*.bmp         binary
*.tif         binary
*.tiff        binary
*.ico         binary
*.woff        binary
*.woff2       binary
*.zip         binary
